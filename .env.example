# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://pishnam:pishnam@localhost:5432/pishnam?schema=public"

# --- Auth (admin panel, NextAuth.js) -------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Public URL of the site, used for callback URLs.
AUTH_URL="http://localhost:3000"

# --- First-run admin bootstrap (see prisma/seed.ts) ------------------------
# Only used once, by `npm run db:seed`, to create the first AdminUser row --
# there is no public sign-up. Unset (or remove from your real .env) after
# the first admin account exists.
SEED_ADMIN_EMAIL="admin@pishnam.example"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# --- Uploads (local disk storage, see docs/05-frontend-architecture.md) --
# Absolute path INSIDE the container where uploaded files are written.
# Must match the Docker named volume mount in docker-compose.yml.
UPLOADS_DIR="/app/uploads"
# Max upload size in bytes, enforced server-side (also set at the nginx level).
UPLOAD_MAX_BYTES="10485760"

# --- Analytics (self-hosted Umami, see docs/09-analytics-i18n.md) -------
NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://your-domain.example/analytics/script.js"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="replace-with-umami-website-id"
UMAMI_DATABASE_URL="postgresql://umami:umami@localhost:5432/umami?schema=public"
UMAMI_APP_SECRET="replace-with-a-long-random-string"

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"
