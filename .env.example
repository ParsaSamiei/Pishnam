# --- Database -----------------------------------------------------------
# Local Docker Compose Postgres:
DATABASE_URL="postgresql://pishnam:pishnam@localhost:5432/pishnam?schema=public"
# Neon (or any PgBouncer pooler): use the *pooled* connection string. Prisma's
# default pool (~17) is too large per Next.js worker; src/lib/prisma.ts caps
# it at connection_limit=5 (+ pool_timeout=20) when talking through a pooler.
# Override in the URL if you need different values.
# DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true"
# For `prisma migrate`, set DIRECT_URL to the non-pooled Neon URL and add
# `directUrl = env("DIRECT_URL")` under datasource in schema.prisma.

# --- Auth (admin panel, NextAuth.js) -------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Public URL of the site, used for callback URLs.
AUTH_URL="http://localhost:3000"
# REQUIRED in production: the app runs behind two reverse proxies (host nginx
# -> container nginx, see infra/nginx-host.conf), and NextAuth v5 rejects
# forwarded Host headers with an UntrustedHost error unless host trust is
# explicit. Without this, admin login fails outright while the rest of the
# site looks fine. Not needed for `next dev`.
AUTH_TRUST_HOST="true"

# --- First-run admin bootstrap (see prisma/seed.ts) ------------------------
# Only used once, by `npm run db:seed`, to create the first AdminUser row --
# there is no public sign-up. Unset (or remove from your real .env) after
# the first admin account exists.
SEED_ADMIN_EMAIL="admin@pishnam.example"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# --- Uploads (local disk storage, see docs/05-frontend-architecture.md) --
# Absolute path INSIDE the container where uploaded files are written.
# Must match the Docker named volume mount in docker-compose.yml.
UPLOADS_DIR="/app/uploads"
# Max upload size in bytes, enforced server-side (also set at the nginx level).
UPLOAD_MAX_BYTES="10485760"

# --- Production database password (docker-compose.yml) --------------------
# Only read by docker-compose, which builds the container DATABASE_URL from it
# and refuses to start if it is unset. Not used by `next dev`.
POSTGRES_PASSWORD="replace-with-a-strong-password"

# --- Analytics (self-hosted Umami, see docs/09-analytics-i18n.md) -------
#
# Production reuses the Umami instance the pishtalk stack already runs on the
# shared server (127.0.0.1:3001, exposed at /analytics by the host nginx) --
# one Umami instance hosts many websites, so Pishnam is just another website
# registered inside it. That is why there is no umami service in
# docker-compose.yml and no UMAMI_APP_SECRET / UMAMI_DATABASE_URL here.
#
# NOTE: both of these are NEXT_PUBLIC_*, so they are frozen into the bundle at
# `next build` -- setting them in .env on the server does nothing. They are
# passed as build args by .github/workflows/deploy.yml, sourced from the
# repository variables UMAMI_SCRIPT_URL and UMAMI_WEBSITE_ID. Leaving them
# unset is fine: components/analytics-script.tsx renders nothing without both.
NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://your-domain.example/analytics/script.js"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="replace-with-umami-website-id"

# --- Site -----------------------------------------------------------------
# Also NEXT_PUBLIC_* and therefore build-time only -- robots.ts, sitemap.ts and
# metadataBase read it. Production value is set by the deploy workflow's
# SITE_URL env, NOT from the server's .env. Changing the public URL (e.g. when
# a real domain replaces the bare IP) needs a rebuild and redeploy.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"
