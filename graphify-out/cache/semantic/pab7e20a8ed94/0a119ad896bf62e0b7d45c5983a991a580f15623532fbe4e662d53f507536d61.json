      "label": "Audience-first homepage design principle",
      "file_type": "rationale",
      "source_file": "docs/02-information-architecture.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Unlike the current WordPress feed, surface distinct per-audience entry points above the general content: hero with bilingual pitch/CTAs and optional admin-managed count-up stats, then students/parents, schools, sponsors blocks, then achievements/news/videos/downloads."
