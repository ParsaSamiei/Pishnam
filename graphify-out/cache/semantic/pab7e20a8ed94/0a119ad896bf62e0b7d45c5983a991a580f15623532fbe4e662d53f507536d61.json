    {
      "id": "docs_02_navigation_structure",
      "label": "Navigation structure recommendation (max 2 levels)",
      "file_type": "rationale",
      "source_file": "docs/02-information-architecture.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Restructure the 5-item deep mega-menu into top-level groups matching audience intent; persistent header CTAs (enroll, language switch, search); sponsors/schools/careers/privacy/terms in footer. Cuts ~5 mega-menus with 8-15 items each to something scannable."
    },
    {
      "id": "docs_02_admin_crud_content_types",
      "label": "Content types requiring admin CRUD",
      "file_type": "concept",
      "source_file": "docs/02-information-architecture.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Any new content type must be added to both 04-database-schema.md and 06-admin-panel.md \u2014 don't hardcode content that should be editable."
    },
    {
      "id": "docs_02_download_center_taxonomy",
      "label": "Download center taxonomy (split flat categories)",
      "file_type": "rationale",
      "source_file": "docs/02-information-architecture.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Software and posters were split out of flat DownloadResource because one flat row can't represent 'one app, several platform builds' or per-competition poster categories; datasheets became a two-level part/variant catalog."
