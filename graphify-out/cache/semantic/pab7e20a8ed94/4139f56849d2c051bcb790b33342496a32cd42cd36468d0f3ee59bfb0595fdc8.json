    {
      "id": "docs_09_event_plan",
      "label": "Lead-focused analytics event plan",
      "file_type": "concept",
      "source_file": "docs/09-analytics-i18n.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Track moments mapping to actual goals (leads) rather than vanity events: enroll, class seat, sponsor, school, job, contact, feedback, video_play, download_click, language_switch \u2014 with fa/en as a property to validate whether English content converts."
    },
    {
      "id": "docs_09_next_intl_approach",
      "label": "next-intl routing + message management",
      "file_type": "concept",
      "source_file": "docs/09-analytics-i18n.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Full bilingual parity, not an English landing page: handles locale-prefixed routing, hreflang, RTL/LTR switching; static UI strings in messages/fa.json and messages/en.json."
    },
    {
      "id": "docs_09_rtl_ltr_handling",
      "label": "RTL/LTR handling (dir, logical properties, icon mirroring)",
      "file_type": "concept",
      "source_file": "docs/09-analytics-i18n.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "dir=rtl on html for fa, dir=ltr for en; Tailwind logical properties; directional icons (arrows, chevrons) need explicit per-locale mirroring \u2014 an easy QA miss."
    },
    {
      "id": "docs_09_content_parity",
      "label": "Content parity workflow (FA/EN fields together)",
      "file_type": "concept",
      "source_file": "docs/09-analytics-i18n.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Show FA and EN fields together so nothing ships half-translated; a missing-translation indicator in the admin list view is an optional nice-to-have, not required for v1."
    }
