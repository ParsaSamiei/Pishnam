// Pishnam -- Prisma schema
// Source of truth: docs/04-database-schema.md -- keep both in sync when this file changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Seed bootstraps the first AdminUser -- see prisma/seed.ts.

enum Locale {
  fa
  en
}

enum Tier {
  ELEMENTARY // ابتدایی
  MIDDLE // متوسطه اول
  HIGH_SCHOOL // متوسطه دوم
  COMPETITIVE // پیشرفته / تیم مسابقات
}

enum LeadType {
  ENROLL
  CLASS_SEAT
  SPONSOR
  SCHOOL
  JOB_APPLICATION
  GENERAL_CONTACT
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum DownloadCategory {
  // SOFTWARE lived here before it got its own SoftwareProduct/SoftwareRelease
  // models below (each app/plugin needed a picture + its own page + several
  // per-platform files, which a flat DownloadResource row can't represent).
  // POSTERS moved to CompetitionPoster under Competition → League → PosterCategory.
  DATASHEETS // دیتاشیت و مستندات فنی
  BOOKS // کتاب و منابع آموزشی
  COMPONENT_LIBRARIES // کتابخانه قطعات CAD (merges former SolidWorks/Altium categories)
}

// Each value maps to a public /downloads/* route and its backing content model.
// CUSTOM sections use an admin-chosen slug and optional DownloadResource rows.
enum DownloadSectionType {
  SOFTWARE
  POSTERS
  DATASHEETS
  BOOKS
  COMPONENT_LIBRARIES
  CUSTOM
}

enum ResourceSource {
  HOSTED // file uploaded to Pishnam's own storage
  EXTERNAL // link out to a third-party site (e.g. official tool page)
}

enum SoftwarePlatform {
  WINDOWS
  MACOS
  LINUX
  WEB
  ANDROID
  IOS
  OTHER
}

enum AdminRole {
  owner
  editor
}

// Every content model with FA/EN text uses either:
//  (a) parallel fields (titleFa/titleEn) for simple models, or
//  (b) a Translation join table for rich-text-heavy models (Course, Article).
// See docs/09-analytics-i18n.md for rationale.

model Course {
  id            String              @id @default(cuid())
  slug          String              @unique
  tier          Tier
  topicTags     String[] // ["electronics","rescue-line", ...]
  coverImage    String
  // Optional Aparat embed URL (canonical form from lib/aparat.ts) shown on the
  // public course page. Paste the share/embed snippet in admin -- not a hosted file.
  aparatUrl       String?
  // Self-hosted video at `/uploads/<uuid>.{mp4,webm}` -- mutually exclusive with aparatUrl.
  hostedVideo     String?
  videoThumbnail  String? // custom poster; falls back to Aparat's poster when empty
  order         Int                 @default(0)
  active        Boolean             @default(true)
  translations  CourseTranslation[]
  classSessions ClassSession[]
  achievements  Achievement[]       @relation("CourseAchievements")
  documents     CourseDocument[]
  images        CourseImage[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tier])
  @@index([active])
}

model CourseTranslation {
  id               String   @id @default(cuid())
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         String
  locale           Locale
  title            String
  excerpt          String
  body             String // rich text (stored as HTML string from Tiptap)
  prerequisites    String?
  // Optional free-text track record of past years' results for this course.
  pastResults      String?
  // Optional checklist of what a student will gain (one item per array entry).
  learningOutcomes String[] @default([])

  @@unique([courseId, locale])
}

// Course-specific attachments (syllabus PDFs, worksheets, etc.) -- separate from
// the global download center so they only appear on the course detail page.
model CourseDocument {
  id            String         @id @default(cuid())
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String
  titleFa       String
  titleEn       String
  descriptionFa String?
  descriptionEn String?
  source        ResourceSource @default(HOSTED)
  fileUrl       String
  fileSizeBytes Int?
  order         Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  @@index([courseId, order])
  @@index([active])
}

// Optional photo gallery for a course detail page (class moments, projects, etc.).
model CourseImage {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  image     String
  captionFa String?
  captionEn String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([courseId, order])
  @@index([active])
}

model ClassSession {
  id           String   @id @default(cuid())
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  weekday      Int // 0-6 (0 = Saturday, per Persian week -- see lib/format)
  startTime    String // "16:00"
  endTime      String
  location     String
  capacityNote String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([courseId])
  @@index([active])
}

model Achievement {
  id          String   @id @default(cuid())
  titleFa     String
  titleEn     String
  competition String // e.g. "RoboCup"
  year        Int
  result      String // e.g. "1st place, Rescue Line"
  photo       String
  courses     Course[] @relation("CourseAchievements")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([year])
  @@index([featured])
}

model TeamMember {
  id                     String    @id @default(cuid())
  nameFa                 String
  nameEn                 String
  roleFa                 String
  roleEn                 String
  photo                  String
  bioFa                  String?
  bioEn                  String?
  resume                 String?
  collaborationStartDate DateTime?
  isAlumni               Boolean   @default(false)
  isVisible              Boolean   @default(true)
  order                  Int       @default(0)
}

model Faq {
  id         String @id @default(cuid())
  category   String
  questionFa String
  questionEn String
  answerFa   String
  answerEn   String
  order      Int    @default(0)

  @@index([category])
}

model VideoEntry {
  id          String   @id @default(cuid())
  titleFa     String
  titleEn     String
  aparatUrl   String? // canonical Aparat embed URL -- mutually exclusive with hostedVideo
  hostedVideo String? // `/uploads/<uuid>.{mp4,webm}` when self-hosted
  thumbnail   String?
  tierTags    Tier[]
  topicTags   String[]
  publishedAt DateTime

  @@index([publishedAt])
}

// Tiles on the public /downloads landing page. Admins can enable/disable,
// reorder, and relabel each section without code changes.
model DownloadSection {
  id          String              @id @default(cuid())
  sectionType DownloadSectionType
  slug        String              @unique
  titleFa     String
  titleEn     String
  iconKey     String              @default("file-text")
  order       Int                 @default(0)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  resources DownloadResource[]

  @@index([active, order])
  @@index([sectionType])
}

model DownloadResource {
  id            String            @id @default(cuid())
  category      DownloadCategory?
  sectionId     String?
  section       DownloadSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  source        ResourceSource // HOSTED or EXTERNAL -- set per resource, both allowed
  cadTool       String? // e.g. "SolidWorks" | "Altium" -- only used for
  // COMPONENT_LIBRARIES category, replaces old separate categories
  titleFa       String
  titleEn       String
  descriptionFa String?
  descriptionEn String?
  fileUrl       String // hosted file path OR external URL, per `source`
  fileSizeBytes Int? // only relevant when source = HOSTED
  createdAt     DateTime         @default(now())

  @@index([category])
  @@index([sectionId])
}

// Competition posters used to be flat DownloadResource rows (category =
// POSTERS). They now follow Competition → League → PosterCategory →
// CompetitionPoster so admins can manage categories per competition and
// league, and the public /downloads/posters page can group accordingly.
model Competition {
  id      String  @id @default(cuid())
  slug    String  @unique
  titleFa String
  titleEn String
  year    Int?
  order   Int     @default(0)
  active  Boolean @default(true)

  leagues   League[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model League {
  id            String      @id @default(cuid())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  competitionId String
  slug          String
  titleFa       String
  titleEn       String
  order         Int         @default(0)
  active        Boolean     @default(true)

  categories PosterCategory[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([competitionId, slug])
  @@index([competitionId])
  @@index([active])
}

model PosterCategory {
  id       String @id @default(cuid())
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId String
  slug     String
  titleFa  String
  titleEn  String
  order    Int    @default(0)
  active   Boolean @default(true)

  posters   CompetitionPoster[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([leagueId, slug])
  @@index([leagueId])
  @@index([active])
}

model CompetitionPoster {
  id            String         @id @default(cuid())
  category      PosterCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId    String
  titleFa       String
  titleEn       String
  descriptionFa String?
  descriptionEn String?
  // Cover/thumbnail shown on the posters grid. Separate from fileUrl so PDF
  // posters can still show a preview image.
  previewImage  String
  source        ResourceSource
  fileUrl       String
  fileSizeBytes Int?
  order         Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([active])
}

// A single app or plugin in the download center (e.g. "mBlock", "Arduino IDE
// driver pack") -- gets its own public page at /downloads/software/[slug].
// One product can have several SoftwareRelease rows (Windows build, macOS
// build, ...), which a flat DownloadResource row couldn't represent.
model SoftwareProduct {
  id            String   @id @default(cuid())
  slug          String   @unique
  // `/uploads/<uuid>.webp` from /api/admin/upload -- shown as the product's
  // cover picture on both the software grid and its own page.
  image         String
  titleFa       String
  titleEn       String
  descriptionFa String?
  descriptionEn String?
  order         Int      @default(0)
  active        Boolean  @default(true)

  releases  SoftwareRelease[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([active])
}

// One downloadable file or link for a SoftwareProduct, tied to a specific
// platform/version -- e.g. "Windows, v2.3.1" and "macOS, v2.3.1" are two
// separate rows under the same product.
model SoftwareRelease {
  id            String           @id @default(cuid())
  product       SoftwareProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  platform      SoftwarePlatform
  versionLabel  String // e.g. "v2.3.1", "Build 114"
  source        ResourceSource // HOSTED or EXTERNAL -- same convention as DownloadResource
  fileUrl       String // hosted file path OR external URL, per `source`
  fileSizeBytes Int? // only relevant when source = HOSTED
  notesFa       String? // e.g. requirements, changelog snippet, install note -- specific to this release
  notesEn       String?
  order         Int              @default(0)
  createdAt     DateTime         @default(now())

  @@index([productId])
}

// Third-party press coverage linking out to external news articles. Managed in
// /admin/media-mentions; surfaced on the homepage and at /press.
model MediaMention {
  id           String   @id @default(cuid())
  outletNameFa String
  outletNameEn String
  headlineFa   String
  headlineEn   String
  url          String // external article URL
  logo         String // `/uploads/<uuid>.webp` outlet mark
  publishedAt  DateTime
  order        Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([active, order])
  @@index([publishedAt])
}

model Article {
  id           String               @id @default(cuid())
  slug         String               @unique
  coverImage   String
  tags         String[]
  publishedAt  DateTime
  translations ArticleTranslation[]

  @@index([publishedAt])
}

model ArticleTranslation {
  id        String  @id @default(cuid())
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  locale    Locale
  title     String
  excerpt   String
  body      String

  @@unique([articleId, locale])
}

model JobPosting {
  id            String    @id @default(cuid())
  titleFa       String
  titleEn       String
  descriptionFa String
  descriptionEn String
  active        Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([active])
}

model Lead {
  id        String     @id @default(cuid())
  type      LeadType
  name      String
  phone     String?
  email     String?
  message   String?
  metadata  Json? // e.g. { courseSlug, tier } for enroll leads
  status    LeadStatus @default(NEW)
  note      String? // internal admin note
  createdAt DateTime   @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// Public "انتقادات و پیشنهادات" submissions from /feedback. Separate from
// Lead because name is optional (anonymous is allowed) and there is no
// phone/email follow-up — staff read/moderate in /admin/feedback.
// `approved` is independent of `read`: admins can publish a message for the
// public wall without (or after) marking it read. Votes are guest-scoped via
// an IP-bound HMAC voter key; one vote per message per client IP, switchable.
model Feedback {
  id           String         @id @default(cuid())
  name         String?
  message      String
  read         Boolean        @default(false)
  approved     Boolean        @default(false)
  likeCount    Int            @default(0)
  dislikeCount Int            @default(0)
  createdAt    DateTime       @default(now())
  votes        FeedbackVote[]

  @@index([createdAt])
  @@index([read])
  @@index([approved, createdAt])
}

enum FeedbackVoteValue {
  like
  dislike
}

model FeedbackVote {
  id         String             @id @default(cuid())
  feedbackId String
  voterKey   String
  value      FeedbackVoteValue
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  feedback   Feedback           @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, voterKey])
  @@index([feedbackId])
}

// Admin auth (custom admin, not public accounts -- see docs/06-admin-panel.md)
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(editor)
  createdAt    DateTime  @default(now())
}

// One-row enrollment guidelines shown before ENROLL and CLASS_SEAT forms.
// Admins edit bilingual rich text from /admin/enrollment-guidelines; when
// `active` and body content exist, applicants must scroll through and
// acknowledge before submitting.
model EnrollmentGuidelines {
  id String @id @default("default")

  active Boolean @default(true)

  titleFa String @default("راهنمای ثبت‌نام")
  titleEn String @default("Before you apply")

  introFa String @default("لطفاً موارد زیر را با دقت بخوانید تا از شرایط کلاس‌ها و قوانین پیشنام آگاه شوید.")
  introEn String @default("Please read the following so you know what to expect from Pishnam classes and how we work together.")

  bodyFa String @default("")
  bodyEn String @default("")

  updatedAt DateTime @updatedAt
}

// One-row site contact details, edited from /admin/contact. Unlike HeroSlide
// this *is* a settings singleton: there is only one address/email/map to show,
// so a table of rows would be the wrong shape. The id is always "default"
// (see CONTACT_SETTINGS_ID); upsert creates the row on first save.
model ContactSettings {
  id String @id @default("default")

  phones String[]
  email  String?

  addressFa String?
  addressEn String?

  // Canonical Google Maps embed URL only (https://www.google.com/maps/embed?...).
  // The admin form accepts a full iframe snippet or a bare embed URL and
  // normalizes it -- see src/lib/google-maps.ts.
  mapEmbedUrl String?

  // Public social profile URLs shown on /contact-us (empty = hidden).
  telegramUrl  String?
  baleUrl      String?
  youtubeUrl   String?
  aparatUrl    String?
  instagramUrl String?

  updatedAt DateTime @updatedAt
}

// Slides in the homepage hero carousel. A plain content collection rather than
// a settings singleton: the hero holds any number of photos, and "how many
// slides exist" is exactly the kind of thing an ordered table answers.
// Zero rows is a valid, expected state -- the hero falls back to the line-art
// board in components/home/hero-showcase.tsx.
model HeroSlide {
  id String @id @default(cuid())

  // `/uploads/<uuid>.webp` path from /api/admin/upload.
  image String
  // Describes the photo for screen readers. Only the admin who uploaded it
  // knows what it shows, so alt text is authored per slide; blank falls back
  // to the generic `home.hero.imageAlt` string in src/messages/*.json.
  altFa String?
  altEn String?

  // Carousel order, low to high -- same convention as TeamMember.order.
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

enum GalleryMediaType {
  IMAGE
  VIDEO
}

// Public media gallery -- photos and videos. Managed in /admin/gallery;
// surfaced as a carousel teaser on the homepage and a full grid with lightbox
// at /gallery.
model GalleryImage {
  id String @id @default(cuid())

  mediaType GalleryMediaType @default(IMAGE)
  image     String? // photo asset, or optional poster for videos
  video     String? // `/uploads/<uuid>.{mp4,webm}` when mediaType = VIDEO
  altFa String?
  altEn String?
  // Optional caption shown under the media in the lightbox.
  captionFa String?
  captionEn String?

  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

// Audit log for every file upload -- required by the upload security
// checklist in docs/05-frontend-architecture.md ("Log every upload").
model UploadLog {
  id             String   @id @default(cuid())
  adminUserId    String
  originalName   String
  storedFilename String
  mimeType       String
  sizeBytes      Int
  field          String // which form field this upload was for, e.g. "course.coverImage"
  createdAt      DateTime @default(now())

  @@index([adminUserId])
}
